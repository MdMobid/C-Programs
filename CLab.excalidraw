      "updated": 1773890528257,
      "link": null,
      "locked": false,
      "text": "Q. WAP to maintain marks of a student in 3 subjects along with Name & Roll No\n\n// For 1 Student\nchar name[20];\nfloat roll;\nfloat pMarks;  // Physics marks\nfloat mMarks;  // Maths marks\nfloat cmarks;  // Chemistry marks\n\n// For 10 Students\nchar name[10][20];\nint roll[10];\nfloat pMarks[10];\nfloat mMarks[10];\nfloat cmarks[10];",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q. WAP to maintain marks of a student in 3 subjects along with Name & Roll No\n\n// For 1 Student\nchar name[20];\nfloat roll;\nfloat pMarks;  // Physics marks\nfloat mMarks;  // Maths marks\nfloat cmarks;  // Chemistry marks\n\n// For 10 Students\nchar name[10][20];\nint roll[10];\nfloat pMarks[10];\nfloat mMarks[10];\nfloat cmarks[10];",
      "autoResize": true,
      "lineHeight": 1.25
    },
